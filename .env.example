# ──────────────────────────────────────────────────
# VeritasAI — Environment Variables
# Copy to .env and fill in actual values
# ──────────────────────────────────────────────────

# ── Application ──
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-character-string
APP_VERSION=0.1.0
APP_NAME=VeritasAI

# ── Backend Server ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1

# ── Database ──
DATABASE_URL=postgresql+asyncpg://veritas:veritas@postgres:5432/veritasai
DATABASE_ECHO=false

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── JWT ──
JWT_SECRET_KEY=change-me-to-a-different-random-64-character-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ── AI Models ──
MODEL_DIR=./models
MODEL_DEVICE=cpu
MODEL_LAZY_LOAD=true

# ── OCR ──
TESSERACT_CMD=/usr/bin/tesseract

# ── Rate Limiting ──
RATE_LIMIT_ENABLED=false

# ── Logging ──
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# ── Frontend (Vite) ──
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=VeritasAI
