# ──────────────────────────────────────────────────
# VeritasAI — Production Environment Configuration
# Copy this file to .env before deploying:
#   cp .env.production.example .env
#
# IMPORTANT:
# Generate secure keys using:
#   openssl rand -hex 32
# ──────────────────────────────────────────────────

# ── Application Runtime ──
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32
APP_VERSION=0.1.0
APP_NAME=VeritasAI

# ── PostgreSQL Database ──
POSTGRES_USER=veritas
POSTGRES_PASSWORD=GENERATE_STRONG_DATABASE_PASSWORD_HERE
POSTGRES_DB=veritasai
DATABASE_URL=postgresql+asyncpg://veritas:${POSTGRES_PASSWORD}@postgres:5432/veritasai
DATABASE_ECHO=false

# ── Redis Cache & Rate Limiter ──
REDIS_URL=redis://redis:6379/0

# ── Security & JWT Authentication ──
# CRITICAL: Must be a distinct 64-character secret
JWT_SECRET_KEY=GENERATE_ANOTHER_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cross-Origin Resource Sharing (CORS) ──
# Set to your production domain(s) separated by commas, e.g. https://veritasai.example.com
CORS_ORIGINS=https://veritasai.example.com,http://localhost

# ── API Documentation (Swagger / OpenAPI) ──
# Recommended false in public production, set true if public API docs are desired
ENABLE_DOCS=false

# ── Rate Limiting ──
# Protects against DoS and brute-force attacks on AI inference and login endpoints
RATE_LIMIT_ENABLED=true

# ── AI Model Configuration ──
MODEL_DIR=./models
MODEL_DEVICE=cpu
MODEL_LAZY_LOAD=true

# ── OCR Engine ──
TESSERACT_CMD=/usr/bin/tesseract

# ── Production Structured Logging ──
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Frontend (Vite) ──
# When served behind Nginx reverse proxy, leave empty to use current host origin
VITE_API_BASE_URL=
VITE_APP_NAME=VeritasAI
