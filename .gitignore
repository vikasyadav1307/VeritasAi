# ──────────────────────────────────────────────
# VeritasAI — .gitignore
# ──────────────────────────────────────────────

# ── Environment ──
.env
.env.*
!.env.example

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.venv/
venv/
ENV/
build/
dist/
*.whl

# ── Testing & Quality ──
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ── Jupyter Notebooks ──
.ipynb_checkpoints/

# ── Node / Frontend ──
node_modules/
frontend/dist/
dist/
frontend/.vite/
.vite/
*.tsbuildinfo

# ── AI Model Weights (Too large for Git; metadata tracked) ──
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.h5
!models/**/.gitkeep
!models/**/config.json
!models/**/tokenizer.json
!models/**/tokenizer_config.json
!models/**/training_results.json

# ── Datasets (Local workspace only) ──
notebooks/data/raw/
notebooks/data/processed/
notebooks/data/augmented/
!notebooks/data/**/.gitkeep

# ── Docker & Logs ──
*.log

# ── IDE & Editors ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS Generated ──
.DS_Store
Thumbs.db
Desktop.ini

# ── Temporary / Scratch ──
*.bak
*.tmp
scratch/